TYPE_WEIGHT={"Placement":3,"Result":2,"Event":1}
def get_score(n):
    weight=TYPE_WEIGHT.get(n["Type"], 1)
    ts=datetime.strptime(n["Timestamp"],"%Y-%m-%d %H:%M:%S").timestamp()
    return weight*10**12+ts

def get_top_n(notifications,n):
    scored=sorted(notifications,key=get_score,reverse=True)
    return scored[:n]

