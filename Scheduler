def knapsack(vehicles, capaity):
    n=len(vehicles)

    dp = [0]*(capacity+1)
    keep=[[False]*(capacity+1) for _ in range(n)]
    for i in range(n):
        d = vehicles[i]["Duration"]
        imp = vehicles[i]["Impact"]

        for w in range(capacity,d-1,-1):
            if dp[w-d]+imp>dp[w]:
                dp[w]=dp[w-d]+imp
                keep[i][w]=True

    seleted = []
    w=capacity
    for i in range(n-1,-1,-1):
        if keep[i][w]:
            selected.append(vehicles[i])
            w-=vehicles[i]["Duration"]
    return dp[capacity], selected

